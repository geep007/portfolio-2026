---
const services = [
  {
    n: "01",
    title: "Design & build, end to end",
    copy: "One person drawing it and building it.",
  },
  {
    n: "02",
    title: "Build from your file",
    copy: "Webflow builds, CMS architecture, motion. Handed back clean.",
  },
  {
    n: "03",
    title: "Stay on as the site team",
    copy: "Monthly hours. Pages, fixes, performance.",
  },
];
---

<section class="services section">
  <div class="rule-head" data-reveal>
    <p class="rule-head__index">
      <span class="label label--lg">(03)</span>
      <span class="label label--lg">Three ways people use us</span>
    </p>
    <p class="rule-head__note">Start anywhere in the project.</p>
  </div>

  <h2 class="services__title" data-reveal style="--reveal-delay:60ms">
    Start at the blank page, or pick it up at the handoff.
  </h2>

  <ul class="services__cards" data-stagger="90">
    {
      services.map((service) => (
        <li class="card" data-reveal>
          <p class="label label--tight card__n">{service.n}</p>
          <div class="card__body">
            <h3 class="card__title">{service.title}</h3>
            <p class="card__copy">{service.copy}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .services {
    display: flex;
    flex-direction: column;
    padding-top: clamp(80px, 9.7vw, 140px);
  }

  .services__title {
    max-width: 63.5%;
    padding-top: clamp(24px, 2.2vw, 32px);
    font-size: var(--text-h2-sm);
    line-height: 1.107;
    letter-spacing: var(--tracking-h2);
    text-wrap: balance;
  }

  .services__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
    padding: clamp(44px, 4.9vw, 70px) 0 0;
    margin: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    min-height: 340px;
    padding: clamp(24px, 2.5vw, 36px);
    border-radius: var(--radius-card);
    background: var(--bg-tint);
    /* The lift is a transform, so the card never nudges its neighbours. */
    transition: transform var(--dur-panel) var(--ease-out-quart);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translate3d(0, -6px, 0);
    }
  }

  .card__n {
    color: var(--brand);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .card__title {
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
    letter-spacing: var(--tracking-h4);
  }

  .card__copy {
    max-width: 79%;
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .services__cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .card {
      min-height: 0;
      gap: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:hover {
      transform: none;
    }
  }
</style>
