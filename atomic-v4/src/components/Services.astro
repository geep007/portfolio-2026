---
const services = [
  {
    n: "01",
    title: "Find the idea",
    copy: "We work out what the site actually needs to say, who it needs to convince, and what can be left out.",
    image: "/img/services/brand.png",
    alt: "Printed brand collateral in blue and off-white",
  },
  {
    n: "02",
    title: "Design it",
    copy: "We turn that into pages, systems and interactions that feel like the company, not a template.",
    image: "/img/services/dev.png",
    alt: "An old monitor glowing brand blue",
  },
  {
    n: "03",
    title: "Build it",
    copy: "Then we make the whole thing work properly across screens, browsers and whatever CMS sits behind it.",
    image: "/img/services/retainer.png",
    alt: "A calendar marked in brand blue",
  },
];
---

<section class="services section" id="services">
  <div class="rule-head" data-reveal>
    <p class="rule-head__index">
      <span class="label label--lg">(03)</span>
      <span class="label label--lg">How we work</span>
    </p>
  </div>

  <div class="services__head" data-reveal style="--reveal-delay:60ms">
    <h2 class="services__title">
      Start at the blank page, or hand us the file.
    </h2>
    <a class="services__link" href="#contact">Ready to get started? Talk to us</a>
  </div>

  <ul class="services__list" data-stagger="90">
    {
      services.map((service) => (
        <li class="row" data-reveal>
          <div class="row__thumb">
            <img
              src={service.image}
              alt={service.alt}
              width="320"
              height="240"
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="label label--tight row__n">{service.n}</p>

          <div class="row__body">
            <h3 class="row__title">{service.title}</h3>
            <p class="row__copy">{service.copy}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .services {
    display: flex;
    flex-direction: column;
    padding-top: clamp(80px, 9.7vw, 140px);
    padding-bottom: var(--section-y);
  }

  .services__head {
    display: flex;
    padding-top: clamp(40px, 4.9vw, 70px);
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(28px, 4vw, 60px);
  }

  .services__title {
    max-width: 63.5%;
    font-size: var(--text-h2-sm);
    line-height: 1.107;
    letter-spacing: var(--tracking-h2);
    text-wrap: balance;
  }

  /* Underlined, the way a signature is underlined — not a button. */
  .services__link {
    flex-shrink: 0;
    padding-bottom: 8px;
    font-size: var(--text-nav);
    border-bottom: 1px solid var(--ink);
    transition: color var(--dur-ui) ease, border-color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .services__link:hover {
      color: var(--brand);
      border-bottom-color: var(--brand);
    }
  }

  .services__list {
    width: 100%;
    padding: clamp(48px, 5.5vw, 80px) 0 0;
    margin: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr) minmax(0, 46px) minmax(0, 5fr);
    align-items: start;
    gap: clamp(20px, 3vw, 48px);
    padding: clamp(28px, 3vw, 44px) 0;
    border-top: 1px solid var(--rule);
  }

  .row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .row__thumb {
    /* Column two of the grid is deliberately empty — the thumb sits alone on
       the left, the way it does in a printed index. */
    grid-column: 1;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-plate);
    background: var(--bg-tint);
  }

  .row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-panel) var(--ease-out-quart);
  }

  @media (hover: hover) and (pointer: fine) {
    .row:hover .row__thumb img {
      transform: scale(1.04);
    }
  }

  .row__n {
    grid-column: 3;
    padding-top: 6px;
    color: var(--brand);
  }

  .row__body {
    grid-column: 4;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .row__title {
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
    letter-spacing: var(--tracking-h4);
  }

  .row__copy {
    max-width: 46em;
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--ink-muted);
  }

  @media (max-width: 1080px) {
    /* The empty spacer column is the first thing to go. */
    .row {
      grid-template-columns: minmax(0, 220px) minmax(0, 40px) minmax(0, 1fr);
    }

    .row__n {
      grid-column: 2;
    }

    .row__body {
      grid-column: 3;
    }
  }

  @media (max-width: 720px) {
    .services__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .services__title {
      max-width: 100%;
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    .row__thumb {
      grid-column: 1;
      max-width: 220px;
    }

    .row__n,
    .row__body {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row__thumb img {
      transition: none;
    }

    .row:hover .row__thumb img {
      transform: none;
    }
  }
</style>
