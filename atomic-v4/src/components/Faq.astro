---
const faqs = [
  {
    q: "What does a site actually cost?",
    a: "Most projects land between ₹1.5L and ₹6L. You get a fixed number before anything starts — no hourly creep.",
  },
  {
    q: "How long does a build take, honestly?",
    a: "Four to eight weeks for a marketing site, depending on page count and how ready the copy is. You get the schedule with the quote, and the checkpoints are on the calendar before we start.",
  },
  {
    q: "Do you work with agencies and other studios?",
    a: "Often. Studios hand over the design file and I build it in Webflow under their name — clean classes, documented CMS, no trace of me in the handoff.",
  },
  {
    q: "Who edits the site after launch?",
    a: "You do. The CMS is built around how your team actually writes, and you get a walkthrough video plus thirty days of fixes on the way out.",
  },
];
---

<section class="faq section">
  <div class="faq__aside">
    <p class="eyebrow" data-reveal>
      <span class="label label--lg">(06)</span>
      <span class="label label--lg">Questions</span>
    </p>
    <h2 class="faq__title" data-reveal style="--reveal-delay:60ms">
      Asked before the first email.
    </h2>
  </div>

  <div class="faq__list" data-stagger="60">
    {
      faqs.map((item, i) => (
        <div class="qa" data-reveal>
          <h3>
            <button
              class="qa__q"
              type="button"
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-a-${i}`}
              id={`faq-q-${i}`}
            >
              <span class="qa__text">{item.q}</span>
              <span class="qa__sign" aria-hidden="true">
                +
              </span>
            </button>
          </h3>
          <div
            class="qa__panel"
            id={`faq-a-${i}`}
            role="region"
            aria-labelledby={`faq-q-${i}`}
            data-open={i === 0 ? "true" : "false"}
          >
            <div class="qa__inner">
              <p class="qa__a">{item.a}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  // One open at a time. The panel is always in the DOM so the region stays
  // addressable for assistive tech; visibility rides on the grid row.
  const faqs = document.querySelectorAll<HTMLButtonElement>(".qa__q");

  faqs.forEach((button) => {
    button.addEventListener("click", () => {
      const panel = document.getElementById(
        button.getAttribute("aria-controls") ?? "",
      );
      if (!panel) return;

      const isOpen = button.getAttribute("aria-expanded") === "true";

      faqs.forEach((other) => {
        const otherPanel = document.getElementById(
          other.getAttribute("aria-controls") ?? "",
        );
        other.setAttribute("aria-expanded", "false");
        otherPanel?.setAttribute("data-open", "false");
      });

      if (!isOpen) {
        button.setAttribute("aria-expanded", "true");
        panel.setAttribute("data-open", "true");
      }
    });
  });
</script>

<style>
  .faq {
    display: flex;
    gap: clamp(28px, 4.2vw, 60px);
    padding-bottom: var(--section-y);
  }

  .faq__aside {
    display: flex;
    flex-direction: column;
    gap: 26px;
    width: 33.3%;
    flex-shrink: 0;
  }

  .faq__title {
    max-width: 95%;
    font-size: clamp(2rem, 3.3vw, 48px);
    line-height: 1.167;
    letter-spacing: var(--tracking-h2);
    text-wrap: balance;
  }

  .faq__list {
    width: 61.9%;
    flex-shrink: 1;
  }

  .qa {
    border-top: 1px solid var(--rule);
  }

  .qa:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .qa__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    min-height: 44px;
    padding: clamp(20px, 2vw, 30px) 0;
    text-align: left;
    font-size: var(--text-h5);
    line-height: var(--leading-h5);
    letter-spacing: var(--tracking-h5);
    transition: color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .qa__q:hover {
      color: var(--brand);
    }
  }

  .qa__sign {
    flex-shrink: 0;
    font-size: var(--text-h5);
    line-height: 1;
    color: var(--brand-soft);
    transition: transform var(--dur-panel) var(--ease-out-quart);
  }

  .qa__q[aria-expanded="true"] .qa__sign {
    transform: rotate(45deg);
  }

  .qa__panel {
    display: grid;
    grid-template-rows: 1fr;
  }

  /* Without the accordion script every answer stays open — a list, not a
     set of dead toggles. */
  :global(.js) .qa__panel {
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows var(--dur-panel) var(--ease-out-quart),
      opacity var(--dur-panel) ease;
  }

  :global(.js) .qa__panel[data-open="true"] {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .qa__inner {
    overflow: hidden;
  }

  .qa__a {
    max-width: 90%;
    padding-bottom: clamp(20px, 2vw, 30px);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .faq {
      flex-direction: column;
    }

    .faq__aside,
    .faq__list {
      width: 100%;
    }

    .faq__title,
    .qa__a {
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .qa__panel,
    .qa__sign,
    .qa__q {
      transition: none;
    }
  }
</style>
