---
// Magazine spread: plates run to the lane edge, captions sit in the gutter
// beside them. Row 01 and 04 are wide with the caption in the margin; 02 and
// 03 pair up in the middle at half scale with their captions underneath.
const projects = [
  {
    index: "01",
    name: "Surreal",
    domain: "letsgetsurreal.com",
    url: "https://letsgetsurreal.com/",
    image: "/img/work-surreal.jpg",
    plate: "#0e0e0e",
    caption: "An immersive digital home for a company that builds immersive physical worlds.",
    stack: "Webflow · GSAP · WebGL",
    year: "2025",
  },
  {
    index: "02",
    name: "Athina.ai",
    domain: "athina.ai",
    url: "https://www.athina.ai/",
    image: "/img/work-athina.jpg",
    plate: "#0e0e0e",
    caption: "Making a deeply technical AI product feel immediate, credible and easy to understand.",
    stack: "Webflow · GSAP · p5.js",
    year: "2025",
  },
  {
    index: "03",
    name: "GROW+",
    domain: "edelgive-growfund.org",
    url: "https://edelgive-growfund.org/",
    image: "/img/work-grow.jpg",
    plate: "#eeede1",
    caption: "Turning years of impact, data and organisations into one clear digital story.",
    stack: "Webflow · CMS architecture",
    year: "2026",
  },
  {
    index: "04",
    name: "Creo Agency",
    domain: "creo-agency.com",
    url: "https://www.creo-agency.com/",
    image: "/img/work-creo.jpg",
    plate: "#efede9",
    caption: "A portfolio designed to feel as expressive as the work inside it.",
    stack: "Webflow · GSAP · CMS",
    year: "2025",
  },
  {
    index: "05",
    name: "Juana de Arco",
    domain: "juanadearcousa.com",
    url: "https://www.juanadearcousa.com/",
    image: "/img/work-juana.jpg",
    plate: "#f2efe8",
    caption: "A colourful Buenos Aires label given a storefront that keeps its handmade character.",
    stack: "Webflow · CMS · Ecommerce",
    year: "2026",
  },
];

const [lead, ...rest] = projects;
// Two half-scale rows behind the lead plate: 02+03, then 04+05.
const pairs = [rest.slice(0, 2), rest.slice(2, 4)];
---

<section class="work" id="work">
  <div class="work__head section">
    <div class="rule-head" data-reveal>
      <p class="rule-head__index">
        <span class="label label--lg">(01)</span>
        <span class="label label--lg">Selected work</span>
      </p>
      <p class="rule-head__note">2024 — 2026</p>
    </div>

    <h2 class="work__title" data-reveal>Five recent builds.</h2>
  </div>

  {/* 01 — plate bleeds right, caption in the left margin. */}
  <article class="spread spread--right" data-reveal>
    <div class="spread__margin">
      <p class="label spread__index">{lead.index}</p>
      <h3 class="spread__name">{lead.name}</h3>
      <p class="spread__caption">{lead.caption}</p>
      <p class="label spread__facts">
        <span>{lead.stack}</span>
        <span>{lead.year}</span>
      </p>
      <a
        class="label link spread__cta"
        href={lead.url || "#contact"}
        target={lead.url ? "_blank" : undefined}
        rel={lead.url ? "noreferrer noopener" : undefined}
      >
        Visit live website <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="frame" style={`background:${lead.plate}`}>
      <div class="frame__bar">
        <span class="frame__dots" aria-hidden="true"><i /><i /><i /></span>
        <span class="label label--tight frame__url">{lead.domain}</span>
      </div>
      <img
        class="frame__media"
        src={lead.image}
        alt={`${lead.name} — live site`}
        width="1800"
        height="1000"
        loading="eager"
        decoding="async"
      />
    </div>
  </article>

  {/* 02 + 03 and 04 + 05 — the uneven pairs. */}
  {
    pairs.map((row) => (
      <div class="pair section">
        {row.map((project, i) => (
          <article class:list={["pair__item", { "pair__item--drop": i === 1 }]} data-reveal>
            <div class="frame" style={`background:${project.plate}`}>
              <div class="frame__bar">
                <span class="frame__dots" aria-hidden="true"><i /><i /><i /></span>
                <span class="label label--tight frame__url">{project.domain}</span>
              </div>
              <img
                class="frame__media"
                src={project.image}
                alt={`${project.name} — live site`}
                width="1800"
                height="1000"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="pair__meta">
              <p class="label spread__index">
                {project.index} — {project.name}
              </p>
              <p class="spread__caption">{project.caption}</p>
              <div class="pair__foot">
                <span class="label pair__facts">
                  {project.stack} — {project.year}
                </span>
                <a
                  class="label link spread__cta"
                  href={project.url || "#contact"}
                  target={project.url ? "_blank" : undefined}
                  rel={project.url ? "noreferrer noopener" : undefined}
                >
                  Visit live website <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    ))
  }

</section>

<style>
  .work {
    display: flex;
    flex-direction: column;
    padding-bottom: clamp(64px, 7vw, 100px);
    background: var(--bg);
  }

  .work__head {
    display: flex;
    flex-direction: column;
    padding-top: clamp(64px, 6.25vw, 90px);
  }

  .work__title {
    max-width: 55.6%;
    padding-top: clamp(32px, 3.9vw, 56px);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-h2);
    text-wrap: balance;
  }

  /* Spread rows ----------------------------------------------------------- */

  .spread {
    display: grid;
    align-items: start;
    gap: clamp(24px, 3vw, 44px);
    padding-top: clamp(56px, 7vw, 100px);
  }

  /* The plate keeps the lane on one side and runs to the viewport on the
     other — the bleed is what makes it read as print. */
  .spread--right {
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    padding-left: var(--lane);
  }

  .spread--left {
    grid-template-columns: minmax(0, 1fr) minmax(0, 260px);
    padding-right: var(--lane);
  }

  .spread__margin {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 6px;
  }

  .spread__index {
    color: var(--brand);
  }

  .spread__name {
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
    letter-spacing: var(--tracking-h4);
  }

  .spread__caption {
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--ink-muted);
  }

  /* Stack and year get a line each — the margin is too narrow to run them
     together without an orphan. */
  .spread__facts {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--ink-faint);
  }

  .spread__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--brand);
  }

  .spread__cta span {
    display: inline-block;
    transition: transform var(--dur-ui) var(--ease-out-quart);
  }

  @media (hover: hover) and (pointer: fine) {
    .spread__cta:hover span {
      transform: translate3d(3px, -3px, 0);
    }
  }

  /* Browser frame --------------------------------------------------------- */

  .frame {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--ink);
  }

  .frame__bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--ink);
    background: var(--bg);
  }

  .frame__dots {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .frame__dots i {
    width: 8px;
    height: 8px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
  }

  .frame__url {
    color: var(--ink-muted);
  }

  .frame__media {
    display: block;
    width: 100%;
    /* Without height:auto the width/height attributes win and the plate
       crops into the screenshot instead of scaling it. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 50% 0;
  }

  /* The middle pair ------------------------------------------------------- */

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(28px, 4vw, 60px);
    padding-top: clamp(56px, 7vw, 100px);
  }

  /* The second plate drops, so the pair never reads as a tidy two-up. */
  .pair__item--drop {
    padding-top: clamp(40px, 5vw, 90px);
  }

  .pair__meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: clamp(16px, 1.6vw, 22px);
  }

  .pair__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .pair__facts {
    color: var(--ink-faint);
  }

  @media (max-width: 900px) {
    /* Stacked, nothing bleeds — the lane holds every edge. */
    .spread--right,
    .spread--left {
      grid-template-columns: minmax(0, 1fr);
      padding-inline: var(--lane);
    }

    /* Phone reads image-first: the plate leads, the caption follows. */
    .spread--left .frame,
    .spread--right .frame {
      order: -1;
    }

    .spread__margin {
      padding-top: 0;
    }

    .pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .pair__item--drop {
      padding-top: 0;
    }

    .work__title {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {  }

  @media (prefers-reduced-motion: reduce) {
    .spread__cta span {
      transition: none;
      transform: none;
    }
  }
</style>
