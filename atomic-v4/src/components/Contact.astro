---
// The close is a business card: two stacked cards on a dark ground — the blue
// face on top, an off-white face peeking out behind it. Everything on them is
// mono, set in parentheses, the way a printed card carries its details.
---

<section class="contact" id="contact">
  <div class="contact__body section">
    <p class="eyebrow contact__eyebrow" data-reveal>
      <span class="label label--lg">(06)</span>
      <span class="label label--lg">Two ways in</span>
    </p>

    <div class="cards" data-reveal style="--reveal-delay:80ms">
      {/* Route one: they already have a project. */}
      <article class="card card--front">
        <div class="card__row">
          <p class="label label--tight card__title">( ATOMIC DESIGNZ )</p>
          <h2 class="card__head">Have something in mind?</h2>
          <p class="card__line card__line--light">
            Tell me what you're building. Rough notes are fine.
          </p>
        </div>

        <div class="card__foot">
          <a
            class="btn btn--light"
            href="https://cal.com/geet-parmar"
            target="_blank"
            rel="noreferrer noopener"
          >
            Start a conversation
          </a>
        </div>
      </article>

      {/* Route two: they're not ready to talk yet. */}
      <article class="card card--back">
        <div class="card__row">
          <p class="label label--tight card__title">( FREE TEARDOWN )</p>
          <h2 class="card__head card__head--ink">Not ready to talk yet?</h2>
          <p class="card__line">
            Send me your website. I'll point out three places where the design
            or copy is losing people and send you a short video back.
          </p>
        </div>

        <div class="card__foot">
          <div class="card__cta">
            <a class="btn" href="mailto:geet@atomicdesignz.com?subject=Teardown">
              Get a 4-minute teardown
            </a>
          </div>

          {/* Punches scattered, not filled in order — a card that's been used. */}
          <ul class="dots" aria-hidden="true">
            {
              Array.from({ length: 9 }).map((_, i) => (
                <li class:list={{ "is-filled": [1, 6, 8].includes(i) }} />
              ))
            }
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--ink);
    color: var(--bg);
  }

  .contact__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(40px, 5vw, 72px);
    padding-block: var(--section-y);
  }

  .contact__eyebrow {
    align-self: flex-start;
    color: rgb(255 255 255 / 62%);
  }

  /* Cards ----------------------------------------------------------------- */

  .cards {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(720px, 100%);
    /* Two faces of the same card, laid out on the table rather than stacked —
       both sides readable at once. */
    gap: clamp(32px, 4.5vw, 64px);
  }

  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(28px, 4vw, 56px);
    width: 100%;
    aspect-ratio: 1.75 / 1;
    padding: clamp(24px, 3.4vw, 44px);
    border-radius: 4px;
  }

  .card--back {
    background: #faf7f0;
    color: var(--ink);
    transform: rotate(-1.5deg);
    box-shadow: 0 24px 60px rgb(0 0 0 / 35%);
  }

  .card--front {
    background: var(--brand);
    color: var(--on-brand);
    transform: rotate(1.5deg);
    box-shadow: 0 24px 60px rgb(0 0 0 / 45%);
  }

  .card__row {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card__head {
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
    letter-spacing: var(--tracking-h4);
    color: var(--on-brand);
  }

  .card__head--ink {
    color: var(--ink);
  }

  .card__cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card__title {
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
  }

  .card__sub {
    opacity: 0.72;
  }

  .card__line {
    max-width: 32em;
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--ink-muted);
  }

  /* Sits on the blue face, so it inverts out of the muted ink above. */
  .card__line--light {
    color: rgb(255 255 255 / 95%);
  }

  .card__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 24px;
  }

  .card__mail {
    font-size: clamp(1.25rem, 2.6vw, 34px);
    line-height: 1.1;
    letter-spacing: var(--tracking-h4);
    color: var(--on-brand);
    border-bottom: 1px solid rgb(255 255 255 / 40%);
    transition: border-color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .card__mail:hover {
      border-bottom-color: var(--on-brand);
    }
  }

  /* Nine punches, three of them inked — the loyalty-card device. */
  .dots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(8px, 1vw, 14px);
    width: clamp(88px, 12vw, 128px);
    align-self: flex-end;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dots li {
    aspect-ratio: 1;
    border: 1px solid var(--brand);
    border-radius: var(--radius-pill);
  }

  .dots li.is-filled {
    background: var(--brand);
  }

  /* Actions --------------------------------------------------------------- */

  .contact__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
  }

  .contact__mail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--bg);
  }

  @media (max-width: 720px) {
    .card {
      aspect-ratio: auto;
      min-height: 240px;
    }

    .card--back {
      transform: rotate(-1deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__mail,
    .row__thumb {
      transition: none;
    }
  }
</style>
