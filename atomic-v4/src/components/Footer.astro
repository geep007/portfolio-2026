---
const social = [
  { label: "LinkedIn", href: "https://www.linkedin.com/company/atomic-designz1/" },
  { label: "Instagram", href: "https://www.instagram.com/geet.space_/" },
];
---

<footer class="footer">
  <div class="footer__bar section">
    <p class="label label--tight footer__note">
      ( ATOMIC DESIGNZ ) story-led websites
    </p>

    <nav class="footer__links" aria-label="Social">
      {
        social.map((item) => (
          <a
            class="label label--tight footer__link"
            href={item.href}
            target="_blank"
            rel="noreferrer noopener"
          >
            {item.label}
          </a>
        ))
      }
      <span class="label label--tight footer__year">© 2026</span>
    </nav>
  </div>
</footer>

<style>
  /* The footer is the same table the cards are lying on. */
  .footer {
    background: var(--ink);
    color: var(--bg);
  }

  .footer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px 32px;
    padding-block: clamp(28px, 3vw, 42px);
    border-top: 1px solid rgb(255 255 255 / 14%);
  }

  .footer__note,
  .footer__year {
    color: rgb(255 255 255 / 55%);
  }

  .footer__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px 32px;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--bg);
    transition: color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__link:hover {
      color: var(--brand-on-dark, #7f8cff);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__link {
      transition: none;
    }
  }
</style>
