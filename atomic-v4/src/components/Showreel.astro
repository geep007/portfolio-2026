---
// Header showreel. The plate widens and un-rounds as it scrolls into place,
// and the frame inside drifts against the scroll — both transform-only.
---

<section class="reel section" aria-label="Showreel">
  <div class="reel__plate" data-scrub>
    <div class="reel__inner">
      <video
        class="reel__video"
        data-autoplay
        poster="/showreel/showreel-poster.jpg"
        preload="metadata"
        muted
        loop
        playsinline
        autoplay
        aria-label="Atomic Designz showreel — recent site builds"
      >
        <source src="/showreel/showreel.webm" type="video/webm" />
        <source src="/showreel/showreel.mp4" type="video/mp4" />
      </video>

      <!-- Autoplay only survives while the clip is muted, so sound is opt-in. -->
      <button class="reel__sound" type="button" data-sound aria-pressed="false">
        <span class="reel__icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none">
            <path
              d="M4 7.5h3L11 4v12L7 12.5H4z"
              fill="currentColor"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"></path>
            <path class="reel__wave" d="M13.5 7.4a3.6 3.6 0 0 1 0 5.2M15.8 5.3a6.8 6.8 0 0 1 0 9.4"
              stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
            <path class="reel__cross" d="M13.6 8.2l4 3.6M17.6 8.2l-4 3.6"
              stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="label label--tight reel__sound-text">Sound off</span>
      </button>
    </div>
  </div>
</section>

<script>
  // The button owns the muted state; nothing else touches it.
  const video = document.querySelector<HTMLVideoElement>("[data-autoplay]");
  const button = document.querySelector<HTMLButtonElement>("[data-sound]");
  const text = button?.querySelector<HTMLElement>(".reel__sound-text");

  if (video && button && text) {
    button.addEventListener("click", () => {
      video.muted = !video.muted;
      button.setAttribute("aria-pressed", String(!video.muted));
      text.textContent = video.muted ? "Sound off" : "Sound on";

      // Unmuting a paused clip should also start it — that's what the click
      // means, and the gesture makes playback allowed.
      if (!video.muted && video.paused) {
        video.play().catch(() => {
          /* still refused — leave the poster up */
        });
      }
    });
  }
</script>

<style>
  .reel {
    padding-bottom: clamp(64px, 7vw, 96px);
  }

  .reel__plate {
    --p: 0;
    position: relative;
    width: 100%;
    margin-inline: auto;
    /* The clip is 16:9. Matching it exactly means nothing is cropped — the
       old 1260/709 box plus a vertical parallax was shaving the frame. */
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0e0e0e;
    border-radius: var(--radius-card);
  }

  /* 0 → just landed, 1 → fully settled. Without the motion bundle the plate
     is simply already settled. */
  :global(.js) .reel__plate {
    /* Only the corners settle. A scale scrub here left the reel sitting
       visibly narrower than the nav lane while it was still the first thing
       on screen — alignment beats the flourish. */
    border-radius: calc(32px - 8px * var(--p));
  }

  .reel__inner {
    position: absolute;
    inset: 0;
  }

  .reel__video {
    width: 100%;
    height: 100%;
    /* contain, not cover — the whole frame is the point. */
    object-fit: contain;
  }

  /* Controls only appear for reduced motion, where the clip doesn't loop. */
  .reel__video[controls] {
    background: #0e0e0e;
  }

  .reel__sound {
    position: absolute;
    right: clamp(12px, 1.4vw, 20px);
    bottom: clamp(12px, 1.4vw, 20px);
    z-index: var(--z-raised);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    color: #fff;
    background: rgb(14 14 14 / 55%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      background-color var(--dur-ui) ease,
      transform var(--dur-ui) var(--ease-out-quart);
  }

  @media (hover: hover) and (pointer: fine) {
    .reel__sound:hover {
      background: var(--brand);
      transform: translate3d(0, -2px, 0);
    }
  }

  .reel__icon {
    display: flex;
    flex-shrink: 0;
  }

  /* Muted shows the cross, unmuted shows the waves — one icon, two states. */
  .reel__wave {
    opacity: 0;
  }

  .reel__sound[aria-pressed="true"] .reel__wave {
    opacity: 1;
  }

  .reel__sound[aria-pressed="true"] .reel__cross {
    opacity: 0;
  }

  /* Reduced motion gets the native controls, which carry their own mute. */
  @media (prefers-reduced-motion: reduce) {
    .reel__sound {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .reel__plate {
      border-radius: var(--radius-card);
      transform: none;
    }
  }
</style>
