---
const steps = [
  {
    n: "01 / Brief",
    copy: "One call, then a written map of pages and message.",
  },
  {
    n: "02 / Design",
    copy: "Art direction and pages drawn against real copy.",
  },
  {
    n: "03 / Build",
    copy: "Webflow, CMS and motion by the same hands that drew it.",
  },
  {
    n: "04 / Review",
    copy: "Focused checkpoints on the live thing, not a flat comp.",
  },
  {
    n: "05 / Handover",
    copy: "Clean CMS, a walkthrough video, thirty days of fixes.",
  },
];
---

<section class="process section" id="process">
  <div class="rule-head" data-reveal>
    <p class="rule-head__index">
      <span class="label label--lg">(04)</span>
      <span class="label label--lg">How we work</span>
    </p>
    <p class="rule-head__note">You see the real thing at every checkpoint.</p>
  </div>

  <h2 class="process__title" data-reveal style="--reveal-delay:60ms">
    Five steps. Nothing mysterious in between.
  </h2>

  <!-- The rule draws itself across as the section scrolls, and each marker
       lands as the line reaches it. Both are scaleX/scale — no layout. -->
  <div class="track" data-scrub="through" aria-hidden="true">
    <div class="track__rail"></div>
    <div class="track__fill"></div>
    {
      steps.map((_, i) => (
        <span class="track__dot" style={`--t:${i / (steps.length - 1)}`}>
          <span class="track__dot-fill" />
        </span>
      ))
    }
  </div>

  <ol class="process__steps" data-stagger="70">
    {
      steps.map((step) => (
        <li class="process__step" data-reveal>
          <p class="label process__n">{step.n}</p>
          <p class="process__copy">{step.copy}</p>
        </li>
      ))
    }
  </ol>

  <div class="process__lane" data-reveal>
    <p class="label process__lane-end">You</p>
    <div class="process__lane-mid">
      <span class="process__lane-bar"></span>
      <p class="label process__lane-note">
        One pair of hands — design and build, no handoff in between
      </p>
    </div>
    <p class="label process__lane-end process__lane-end--right">Yours again</p>
  </div>
</section>

<style>
  .process {
    display: flex;
    flex-direction: column;
    padding-block: var(--section-y);
  }

  .process__title {
    max-width: 85.7%;
    padding-top: clamp(40px, 4.9vw, 70px);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-thesis);
    text-wrap: balance;
  }

  /* Track ----------------------------------------------------------------- */

  .track {
    --p: 0;
    /* Remap the raw travel so the line finishes while the section is still
       comfortably on screen rather than at the moment it exits. */
    --f: clamp(0, calc(var(--p) * 1.9 - 0.32), 1);
    position: relative;
    width: 100%;
    height: 14px;
    margin-top: clamp(56px, 6.25vw, 90px);
  }

  .track__rail,
  .track__fill {
    position: absolute;
    top: 6px;
    left: 0;
    width: 100%;
    height: 1px;
  }

  .track__rail {
    background: rgb(26 46 242 / 22%);
  }

  .track__fill {
    background: var(--brand);
    transform-origin: left;
  }

  :global(.js) .track__fill {
    transform: scaleX(var(--f));
    will-change: transform;
  }

  .track__dot {
    position: absolute;
    top: 0;
    left: calc(var(--t) * 100%);
    width: 14px;
    height: 14px;
    /* Pull the last marker back inside the rail. */
    margin-left: calc(var(--t) * -14px);
    box-shadow: inset 0 0 0 1.5px var(--brand);
    background: var(--bg);
  }

  .track__dot-fill {
    position: absolute;
    inset: 0;
    background: var(--brand);
  }

  /* 0 until the fill arrives at this marker, then snaps up over a short
     slice of scroll. */
  :global(.js) .track__dot-fill {
    transform: scale(clamp(0, calc((var(--f) - var(--t)) * 14), 1));
  }

  /* Steps ------------------------------------------------------------------ */

  .process__steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 52px);
    width: 100%;
    padding: clamp(24px, 2.4vw, 34px) 0 0;
    margin: 0;
    list-style: none;
  }

  .process__step {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .process__n {
    color: var(--brand);
  }

  .process__copy {
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--ink-muted);
  }

  /* Lane ------------------------------------------------------------------- */

  .process__lane {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding-top: clamp(32px, 3vw, 44px);
  }

  .process__lane-end {
    width: 23.8%;
    flex-shrink: 1;
    color: rgb(14 14 14 / 40%);
  }

  .process__lane-end--right {
    text-align: right;
  }

  .process__lane-mid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 50.8%;
    flex-shrink: 1;
  }

  .process__lane-bar {
    height: 2px;
    background: var(--brand);
    transform-origin: left;
  }

  :global(.js) .process__lane-bar {
    transform: scaleX(0);
    transition: transform 1100ms var(--ease-out-quart) 120ms;
  }

  :global(.js) .process__lane.is-in .process__lane-bar {
    transform: scaleX(1);
  }

  .process__lane-note {
    color: var(--brand);
  }

  @media (max-width: 1000px) {
    .process__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }

    .track {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .process__title {
      max-width: 100%;
    }
  }

  @media (max-width: 720px) {
    .process__lane {
      flex-direction: column;
      align-items: flex-start;
    }

    .process__lane-end,
    .process__lane-mid {
      width: 100%;
    }

    .process__lane-end--right {
      text-align: left;
    }
  }

  @media (max-width: 520px) {
    .process__steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .process__lane-bar {
      transform: scaleX(1);
      transition: none;
    }
  }
</style>
