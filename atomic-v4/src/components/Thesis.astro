---
const scale = [
  {
    title: "Find the story",
    copy: "Strip the idea down until the thing worth saying becomes obvious.",
    svg: `<circle cx="40" cy="40" r="5" fill="#FFFFFF"/>`,
  },
  {
    title: "Give it a shape",
    copy: "Turn that story into a visual system and an experience.",
    svg: `<circle cx="40" cy="40" r="5" fill="#FFFFFF"/>
      <circle cx="40" cy="40" r="22" fill="none" stroke="#FFFFFFA6" stroke-width="0.9"/>
      <g class="orbit"><circle cx="62" cy="40" r="3.4" fill="#FFFFFF"/></g>`,
  },
  {
    title: "Make it move",
    copy: "Use interaction and motion where they add meaning, not decoration.",
    svg: `<circle cx="26" cy="40" r="5" fill="#FFFFFF"/>
      <circle cx="54" cy="40" r="5" fill="#FFFFFF"/>
      <path d="M26 40H54" fill="none" stroke="#FFFFFFA6" stroke-width="0.9"/>
      <circle cx="26" cy="40" r="16" fill="none" stroke="#FFFFFF66" stroke-width="0.8"/>
      <circle cx="54" cy="40" r="16" fill="none" stroke="#FFFFFF66" stroke-width="0.8"/>`,
  },
  {
    title: "Build it properly",
    copy: "Fast, responsive and manageable long after we hand it over.",
    svg: `<path d="M40 24L24 40L40 56L56 40L40 24Z" fill="none" stroke="#FFFFFF80" stroke-width="0.8"/>
      <circle cx="40" cy="24" r="4" fill="#FFFFFF"/>
      <circle cx="24" cy="40" r="4" fill="#FFFFFF"/>
      <circle cx="56" cy="40" r="4" fill="#FFFFFF"/>
      <circle cx="40" cy="56" r="4" fill="#FFFFFF"/>
      <circle cx="40" cy="40" r="2.6" fill="#FFFFFF99"/>`,
  },
];
---

<section class="thesis on-brand" id="studio">
  <div class="thesis__body section">
    <p class="eyebrow" data-reveal>
      <span class="label label--lg">(02)</span>
      <span class="label label--lg">Why we do it this way</span>
    </p>

    <h2 class="thesis__title" data-reveal style="--reveal-delay:60ms">
      Specs don't sell. Stories do.
    </h2>

    <p class="thesis__lede" data-reveal style="--reveal-delay:140ms">
      A website can be technically perfect and still say nothing. We start
      with what someone needs to understand, feel and remember, then use
      design, motion and code to make that happen.
    </p>

    <ul class="thesis__scale" data-stagger="90">
      {
        scale.map((step) => (
          <li class="thesis__step" data-reveal>
            <svg
              class="thesis__atom"
              width="80"
              height="80"
              viewBox="0 0 80 80"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              set:html={step.svg}
            />
            <div class="thesis__text">
              <p class="thesis__step-title">{step.title}</p>
              <p>{step.copy}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .thesis {
    background: var(--brand);
    color: var(--on-brand);
  }

  .thesis__body {
    display: flex;
    flex-direction: column;
    padding-block: var(--section-y-sm);
  }

  .thesis__title {
    max-width: 85.7%;
    padding-top: clamp(28px, 3vw, 44px);
    font-size: var(--text-thesis);
    line-height: var(--leading-thesis);
    letter-spacing: var(--tracking-thesis);
    color: var(--on-brand);
    text-wrap: balance;
  }

  .thesis__lede {
    max-width: min(50.8%, 34em);
    padding-top: clamp(24px, 2.4vw, 34px);
    font-size: var(--text-lede);
    line-height: var(--leading-lede);
    color: var(--on-brand-muted);
  }

  .thesis__scale {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 40px);
    width: 100%;
    margin: clamp(64px, 8.3vw, 120px) 0 0;
    padding: clamp(32px, 3vw, 44px) 0 0;
    border-top: 1px solid var(--on-brand-rule);
    list-style: none;
  }

  .thesis__step {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .thesis__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .thesis__step-title {
    font-size: var(--text-nav);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--on-brand);
  }

  .thesis__step p {
    max-width: 79%;
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--on-brand-muted);
  }

  .thesis__atom {
    flex-shrink: 0;
  }

  /* The electron keeps its orbit. Slow enough to read as ambient, not as a
     spinner — and it holds still once the section is off-screen anyway. */
  .thesis__atom :global(.orbit) {
    transform-origin: 40px 40px;
    animation: orbit 9s linear infinite;
  }

  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 900px) {
    .thesis__scale {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .thesis__title,
    .thesis__lede,
    .thesis__step p {
      max-width: 100%;
    }
  }

  @media (max-width: 520px) {
    .thesis__scale {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thesis__atom :global(.orbit) {
      animation: none;
    }
  }
</style>
