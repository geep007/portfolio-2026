---
// Both quotes are LinkedIn recommendations, trimmed to the working sentences.
const quotes = [
  {
    text: "Working with Geet has been a truly smooth and reliable experience. He is not only skilled in his craft but also incredibly proactive, communicative, and solution-driven.",
    name: "Chiméne Adoptie",
    role: "Founder & Creative Strategist, CREO Agency",
    date: "July 2025",
  },
  {
    text: "Geet and the team at Atomic Designz were instrumental in bringing our website to life. Their cooperative approach and on-time delivery meant minimal back-and-forth for us.",
    name: "Natasha Bandodkar",
    role: "Co-Founder & Lead Strategist, Independent Creators Co",
    date: "June 2025",
  },
];
---

<section class="says section">
  <div class="rule-head" data-reveal>
    <p class="rule-head__index">
      <span class="label label--lg">(04)</span>
      <span class="label label--lg">What people say</span>
    </p>
    <p class="rule-head__note">What it's like to work together.</p>
  </div>

  <ul class="says__list" data-stagger="90">
    {
      quotes.map((quote) => (
        <li class="says__item" data-reveal>
          <figure class="says__figure">
            <blockquote class="says__text">“{quote.text}”</blockquote>
            <figcaption class="says__foot">
              <span class="label says__name">{quote.name}</span>
              <span class="label says__role">{quote.role}</span>
              <span class="label says__date">{quote.date}</span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .says {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--section-y);
  }

  .says__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 4.5vw, 64px);
    width: 100%;
    padding: clamp(44px, 4.9vw, 70px) 0 0;
    margin: 0;
    list-style: none;
  }

  .says__item {
    display: flex;
  }

  .says__figure {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(28px, 3vw, 44px);
    width: 100%;
    margin: 0;
    padding-top: clamp(24px, 2.4vw, 34px);
    border-top: 1px solid var(--rule);
  }

  .says__text {
    margin: 0;
    font-size: var(--text-quote);
    line-height: var(--leading-quote);
    letter-spacing: var(--tracking-h4);
    text-wrap: pretty;
  }

  .says__foot {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .says__role,
  .says__date {
    color: var(--ink-faint);
  }

  @media (max-width: 900px) {
    .says__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
