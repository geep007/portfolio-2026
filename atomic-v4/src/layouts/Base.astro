---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Share card, relative to the site root. 1200x630. */
  image?: string;
  /** Lab and utility pages keep themselves out of search results. */
  noindex?: boolean;
}

const {
  title = "Atomic Designz — Story-led websites, built in Webflow",
  description =
    "We write the story and design the page together, then build it in Webflow so your team can edit it in three clicks. Sites for founders, funds and studios.",
  image = "/og.jpg",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
// Share cards are fetched by crawlers that never resolve relative paths, so the
// image has to be absolute and on the same host as the canonical URL.
const ogImage = new URL(image, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1a2ef2" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Atomic Designz" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Atomic Designz — we tell stories on the web"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="Atomic Designz — we tell stories on the web"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- The display face carries the hero; everything waits on it. -->
    <link
      rel="preload"
      href="/fonts/nhd-roman.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/tronica-mono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/showreel/showreel-poster.jpg" as="image" />

    <!-- Every hidden-then-revealed style is gated on this class, so if the
         motion bundle never runs the page is simply the finished page. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import "../scripts/motion.ts";
    </script>
    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: var(--z-overlay);
        padding: 12px 20px;
        background: var(--brand);
        color: var(--on-brand);
        font-size: var(--text-nav);
      }

      .skip:focus {
        left: 12px;
        top: 12px;
      }
    </style>
  </body>
</html>
