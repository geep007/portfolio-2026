# Track only the two shipped projects; everything else in this folder is scratch.
/*
!/.gitignore
!/README.md
!/atomic-v4/
!/showreel/
!/aval/

# AVAL master frame sequences. Large, and both are regenerated by the commands
# in aval/README.md — the compiled .avl bundles that actually ship are committed
# under atomic-v4/public/aval/.
/aval/*/frames/
/aval/*/*/frames/

# Build + dependency output inside the tracked projects
node_modules/
dist/
out/
.astro/
.DS_Store
npm-debug.log*
.env
.env.production
